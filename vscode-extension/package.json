{
  "name": "airalang",
  "displayName": "AiraLang Language Support",
  "description": "Rich language support, syntax highlighting, and code snippets for AiraLang.",
  "version": "1.0.0",
  "publisher": "adameehan",
  "author": {
    "name": "Adam Eehan (Aira Group of Technology)"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "airalang",
    "aira",
    "cyber",
    "systems"
  ],
  "contributes": {
    "languages": [
      {
        "id": "airalang",
        "aliases": ["AiraLang", "aira"],
        "extensions": [".aira"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "airalang",
        "scopeName": "source.aira",
        "path": "./syntaxes/airalang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "airalang",
        "path": "./snippets/snippets.json"
      }
    ]
  }
}
